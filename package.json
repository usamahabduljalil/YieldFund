{
  "name": "yieldfund-on-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/domain",
    "packages/near-client"
  ],
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "deployment": "node --experimental-strip-types scripts/deployment.mjs",
    "dev": "npm run dev --workspace apps/web -- --host 127.0.0.1 --port 4173 --strictPort",
    "dev:testnet": "node --experimental-strip-types scripts/serve-testnet.mjs",
    "build": "npm run typecheck && npm run build --workspace apps/web",
    "build:host": "npm run build && node --experimental-strip-types scripts/prepare-vercel.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:sites": "npm run test:sites --workspace apps/web"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
